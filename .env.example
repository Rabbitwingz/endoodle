# Copy to .env.local for local development. On Vercel, set these under
# Project → Settings → Environment Variables.

# Required: your OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Required in production: the shared password employees use to sign in.
# Changing it signs everyone out.
APP_PASSWORD=change-me

# Optional: image quality — low | medium | high (default: medium).
# Higher quality looks better but costs more and is slower.
IMAGE_QUALITY=medium

# Optional: OpenAI image model (default: gpt-image-1)
# OPENAI_IMAGE_MODEL=gpt-image-1
